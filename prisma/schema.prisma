generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  // Stored lowercased. Uniqueness is enforced here, not only in code.
  email           String    @unique
  name            String
  // bcrypt hash. The plain password is never stored.
  passwordHash    String
  // Null until the emailed code is confirmed.
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  sessions           Session[]
  verificationCodes  VerificationCode[]
  passwordResetTokens PasswordResetToken[]
  paymentEvents       PaymentEvent[]
  subscription        Subscription?
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the cookie value. The raw token only ever lives in the cookie.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the 6-digit code.
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  // Wrong guesses against this code. The code dies at the configured maximum.
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // SHA-256 of the token in the emailed link.
  tokenHash String    @unique
  expiresAt DateTime
  // Set once, atomically, when the token is redeemed.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model RateLimit {
  // "<action>:<ip or email>"
  key         String   @id
  count       Int
  windowStart DateTime
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

// The stages of one payment. Each is its own row; none is ever edited.
enum PaymentEventType {
  INITIATION   // we created a reference and asked the provider to collect
  VERIFICATION // our server asked the provider and it confirmed the money
  FULFILMENT   // we granted the paid period
  FAILURE      // the provider or our own checks said no
  DUPLICATE    // a repeat notification for an already fulfilled reference
}

enum PaymentSource {
  CHECKOUT
  RETURN
  WEBHOOK
  RENEWAL
}

enum PaymentKind {
  SUBSCRIBE
  UPGRADE
  RENEWAL
}

// Append-only payment log. A database trigger rejects UPDATE and DELETE.
// Entitlement is derived from the FULFILMENT rows here, not stored elsewhere.
model PaymentEvent {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  // The provider reference. Generated by us, sent to the provider, and the
  // idempotency key for everything that happens to this payment.
  reference   String
  type        PaymentEventType
  source      PaymentSource
  kind        PaymentKind
  interval    BillingInterval
  // Whole minor units (kobo). Never a decimal.
  amountMinor Int
  currency    String
  // Proration credit applied to this charge, in minor units.
  creditMinor Int              @default(0)
  // Set only on FULFILMENT: the span of access this payment bought.
  periodStart DateTime?
  periodEnd   DateTime?
  // Provider status, channel, reasons. Never card details.
  detail      Json?
  createdAt   DateTime

  @@index([userId, type, createdAt])
  @@index([reference])
}

// Choices the user has made about the future. No plan, status or dates live
// here: those come from the payment log.
model Subscription {
  userId                String           @id
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  cancelAtPeriodEnd     Boolean          @default(false)
  cancelledAt           DateTime?
  cancellationReason    String?
  // A downgrade waiting for the end of the current period.
  pendingInterval       BillingInterval?
  // The provider's reusable token for renewals. A reference to a card held by
  // the provider, not card data.
  providerAuthorization String?
  updatedAt             DateTime         @updatedAt
}
