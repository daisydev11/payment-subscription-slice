# Copy this file to .env and fill in the values by hand. Never commit .env.

# PostgreSQL connection string. From your Neon/Supabase project settings,
# or a local Postgres. The ?schema=billing part keeps this slice in its own schema.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=billing"
DATABASE_URL=

# Public base URL of the app. Used for the payment return link and emails.
# APP_URL="http://localhost:3000"
APP_URL=

# Paystack TEST secret key (Paystack dashboard -> Settings -> API Keys & Webhooks).
# Starts with sk_test_. Also used to check webhook signatures.
# With the local simulator any value works, as long as both sides share it.
# PAYSTACK_SECRET_KEY="sk_test_xxxxxxxx"
PAYSTACK_SECRET_KEY=

# Leave empty to use the real Paystack API (https://api.paystack.co).
# Set to the simulator's address to develop without a Paystack account.
# PAYSTACK_BASE_URL="http://localhost:4010"
PAYSTACK_BASE_URL=

# Any long random string. The renewal job must send it as a Bearer token.
# Generate one with: openssl rand -hex 32
# CRON_SECRET="xxxxxxxx"
CRON_SECRET=

# Development only: move the billing clock forward by this many days, to
# demonstrate mid-cycle upgrades and renewals. Ignored in production.
# CLOCK_OFFSET_DAYS=11
CLOCK_OFFSET_DAYS=

# Resend API key (https://resend.com/api-keys). Leave empty in local
# development: emails are then printed to the server terminal instead of sent.
# RESEND_API_KEY="re_xxxxxxxx"
RESEND_API_KEY=

# The "from" address for emails. Needed only with a Resend key.
# EMAIL_FROM="Subscription Slice <onboarding@resend.dev>"
EMAIL_FROM=
